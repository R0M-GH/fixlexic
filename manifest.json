{
  "manifest_version": 3,
  "name": "Fixlexic",
  "version": "1.0.0",
  "description": "Bionic reading for ADHD and dyslexic brains. Bolds the start of every word. Fully local, no network access.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Fixlexic"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+B", "mac": "Alt+B" },
      "description": "Toggle Fixlexic on the current site"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
